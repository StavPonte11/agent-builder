{
    "dashboard": {
        "title": "Agent Platform Metrics",
        "tags": [
            "agent-platform"
        ],
        "timezone": "browser",
        "panels": [
            {
                "id": 1,
                "title": "Request Rate",
                "type": "graph",
                "gridPos": {
                    "x": 0,
                    "y": 0,
                    "w": 12,
                    "h": 8
                },
                "targets": [
                    {
                        "expr": "rate(http_requests_total[5m])",
                        "legendFormat": "{{method}} {{endpoint}}"
                    }
                ]
            },
            {
                "id": 2,
                "title": "Request Latency (p95)",
                "type": "graph",
                "gridPos": {
                    "x": 12,
                    "y": 0,
                    "w": 12,
                    "h": 8
                },
                "targets": [
                    {
                        "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
                        "legendFormat": "{{endpoint}}"
                    }
                ]
            },
            {
                "id": 3,
                "title": "Active Workflows",
                "type": "stat",
                "gridPos": {
                    "x": 0,
                    "y": 8,
                    "w": 6,
                    "h": 4
                },
                "targets": [
                    {
                        "expr": "count(temporal_workflow_running)"
                    }
                ]
            },
            {
                "id": 4,
                "title": "Error Rate",
                "type": "graph",
                "gridPos": {
                    "x": 6,
                    "y": 8,
                    "w": 18,
                    "h": 8
                },
                "targets": [
                    {
                        "expr": "rate(http_requests_total{status=~\"5..\"}[5m])",
                        "legendFormat": "{{endpoint}}"
                    }
                ]
            }
        ]
    }
}